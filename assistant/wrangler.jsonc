{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": { "ALLOWED_ORIGINS": "https://thanagorn.com" },
  "durable_objects": {
    "bindings": [{ "name": "USAGE_GUARD", "class_name": "UsageGuard" }],
  },
  "exports": {
    "UsageGuard": { "type": "durable-object", "storage": "sqlite" },
  },
}
