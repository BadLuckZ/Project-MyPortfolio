{
  "name": "assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "type-check": "wrangler types && tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "build:profile": "node scripts/build-profile.ts",
    "count:token": "node scripts/count-token.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "gpt-tokenizer": "4.1.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "vitest": "^5.1.1"
  }
}
